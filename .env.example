# Скопируйте в .env и заполните. Для Firebase Hosting: перед deploy те же
# переменные должны быть в .env (или в среде CI), иначе в сборку не попадут ключи.

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Обычно ПУСТО: тогда используется база "(default)".
# НЕ подставляйте measurementId вида G-XXXXXXXX — это не Firestore!
# Свой именованный database id — только если создавали вторую БД в консоли Firestore.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Gemini API Key — через vite.config define попадает в клиентский бандл.
# Любой может извлечь ключ из собранного JS; для продакшена лучше прокси (Cloud Function / свой backend).
GEMINI_API_KEY=
