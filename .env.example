# Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git!

PORT=3000

# Gemini API Key — используется ТОЛЬКО на сервере (через Express proxy).
# Не попадает в клиентский бандл (vite.config.ts исключает серверные переменные).
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — основная база данных проекта
# Получить в: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
