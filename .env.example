# ==============================================================================
# PromptVault Environment Configuration
# Скопируйте этот файл в .env перед запуском (или оставьте по умолчанию для SQLite)
# ==============================================================================

# Режим базы данных: 
# 'local' — локальная база SQLite (data/promptvault.db) + папка картинок data/uploads/
# 'cloud' — облачная база Supabase (PostgreSQL + Storage)
DB_MODE=local
PORT=3000

# Google Gemini API Key — используется для работы AI Smart Parser (gemini-3.1-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (нужны только если DB_MODE=cloud)
# Получить в: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
